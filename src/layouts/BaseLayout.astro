---
import { SEO } from 'astro-seo';
import ogImage from '../assets/logo.png';
import { SITE } from '../data/site';
import AnimatedBackground from '../components/AnimatedBackground.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Omit the max-width wrapper for full-bleed pages like the homepage hero. */
  wide?: boolean;
  /** og:type — 'article' for blog posts, 'website' everywhere else. */
  type?: 'website' | 'article';
  /** Keep a page out of search results. Used for /search/, which is an empty shell until Pagefind runs. */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  wide = false,
  type = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
// just-the-docs rendered "<page> | Wallpaper Reactor"; keep that format so titles
// already indexed by search engines don't change shape.
const fullTitle = Astro.url.pathname === '/' ? SITE.title : `${title} | ${SITE.title}`;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <SEO
      title={fullTitle}
      description={description}
      canonical={canonical}
      noindex={noindex}
      nofollow={noindex}
      openGraph={{
        // Share cards must use the composed title. Passing the bare `title` prop here
        // meant the homepage shared as "Home".
        // og:image must be absolute; ogImage.src is the hashed build path.
        basic: { title: fullTitle, type, url: canonical, image: new URL(ogImage.src, SITE.url).href },
        optional: { description, siteName: SITE.title, locale: 'en_US' },
      }}
      twitter={{ card: 'summary', title: fullTitle, description }}
    />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: SITE.title,
        url: SITE.url,
        logo: new URL(ogImage.src, SITE.url).href,
        founder: { '@type': 'Person', name: SITE.author },
      })}
    />

    <GoogleAnalytics />
  </head>

  <body class="min-h-screen">
    <AnimatedBackground />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-surface-850 focus:px-4 focus:py-2"
      >Skip to main content</a
    >

    <Header />

    <main id="main" class={wide ? '' : 'mx-auto max-w-7xl px-4 py-8'}>
      <slot />
    </main>

    <Footer />
  </body>
</html>
