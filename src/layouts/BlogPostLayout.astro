---
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  /** Social-share image, from the post's `image` front matter. */
  image?: ImageMetadata;
  /** Related posts, from the post's `related` front matter. */
  related?: { href: string; title: string; description: string }[];
  /** Social share image, from the post's `image` front matter. */
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, description, publishDate, updatedDate, related = [], image, imageAlt } = Astro.props;

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
const shown = updatedDate ?? publishDate;
---

<BaseLayout title={title} description={description} type="article" image={image} imageAlt={imageAlt}>
  <article class="prose-wr mx-auto max-w-4xl">
    <h1>{title}</h1>
    <p class="text-[1.05rem] leading-relaxed text-ink-400">
      {updatedDate ? 'Last updated' : 'Published'}: {fmt(shown)}
    </p>
    <slot />
    <!-- Analytics.astro sends `read_post` when this end-of-article marker is reached. -->
    <div data-read-end data-post-slug={Astro.url.pathname}></div>
    {related.length > 0 && (
      <nav aria-labelledby="related-guides">
        <h2 id="related-guides">Related guides</h2>
        <ul>
          {related.map((r) => (
            <li>
              <a href={r.href}>{r.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </article>
</BaseLayout>

<script type="application/ld+json" is:inline set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: publishDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { '@type': 'Person', name: 'Kyle Eichlin' },
})} />
