---
import { Image } from 'astro:assets';
import googlePlay from '../assets/google-play-button.png';
import { STORES } from '../data/site';

/** The Microsoft and Apple badges are SVG, which needs no processing — only the
    Google Play raster goes through astro:assets. */
const SVG_BADGES = [
  { href: STORES.microsoft, src: '/assets/images/microsoft-store-badge.svg', alt: 'Get it from Microsoft' },
  { href: STORES.appStoreLite, src: '/assets/images/apple-store-button.svg', alt: 'Download on the App Store' },
];
---

<div class="flex flex-wrap items-center justify-center gap-4">
  <a href={STORES.googlePlay} target="_blank" rel="noopener" class="transition-transform hover:-translate-y-0.5">
    <Image src={googlePlay} alt="Get it on Google Play" densities={[1, 2]} class="h-12 w-auto" />
  </a>
  {
    SVG_BADGES.map((b) => (
      <a href={b.href} target="_blank" rel="noopener" class="transition-transform hover:-translate-y-0.5">
        <img src={b.src} alt={b.alt} class="h-12 w-auto" />
      </a>
    ))
  }
</div>
