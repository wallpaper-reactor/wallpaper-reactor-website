---
import { NAV, SITE } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header
  class="sticky top-0 z-50 border-b border-white/10 bg-surface-900/80 backdrop-blur-md"
>
  <nav class="mx-auto flex max-w-7xl items-center gap-6 px-4 py-3" aria-label="Main">
    <a href="/" class="flex shrink-0 items-center gap-2 text-ink-100 hover:text-ink-100">
      <img src="/assets/images/logo.png" alt="" width="28" height="28" class="h-7 w-7" />
      <span class="font-semibold tracking-tight">{SITE.title}</span>
    </a>

    <ul class="ml-auto hidden items-center gap-1 md:flex">
      {
        NAV.slice(1).map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-lg px-3 py-2 text-sm transition-colors',
                isActive(item.href)
                  ? 'bg-white/5 text-ink-100'
                  : 'text-ink-400 hover:bg-white/5 hover:text-ink-100',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <form action="/search/" method="get" class="hidden lg:block">
      <label class="sr-only" for="site-search">Search Wallpaper Reactor</label>
      <input
        id="site-search"
        type="search"
        name="q"
        placeholder="Search"
        class="w-40 rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-ink-300 placeholder:text-ink-500 focus:border-brand-400/50 focus:outline-none"
      />
    </form>

    <button
      type="button"
      id="nav-toggle"
      class="ml-auto rounded-lg p-2 text-ink-300 hover:bg-white/5 md:hidden"
      aria-controls="mobile-nav"
      aria-expanded="false"
      aria-label="Toggle menu"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </nav>

  <ul id="mobile-nav" class="hidden border-t border-white/10 px-4 pb-3 md:hidden">
    {
      NAV.slice(1).map((item) => (
        <li>
          <a
            href={item.href}
            class="block rounded-lg px-3 py-2 text-sm text-ink-300 hover:bg-white/5 hover:text-ink-100"
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
