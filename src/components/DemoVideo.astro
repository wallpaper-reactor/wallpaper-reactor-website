---
/**
 * A real screen recording of the app, by its id in `src/data/demoClips.js`. Emits the figure, the caption
 * and the clip's VideoObject JSON-LD (built in `src/data/videoObject.js`, the only builder).
 *
 * The sources are named in `data-src` and set by `src/scripts/demo-video.js` when the clip scrolls near, because
 * `autoplay` would otherwise download an off-screen clip at page load. With `prefers-reduced-motion` it never
 * autoplays and shows the poster with controls. Without JavaScript the poster shows, with a link to the file.
 */
import { DEMO_CLIPS } from '../data/demoClips.js';
import { SITE } from '../data/site';
import { clipUrls, videoObjectSchema } from '../data/videoObject.js';

interface Props {
  id: string;
  /** Overrides the caption in `demoClips.js` for one placement. */
  caption?: string;
  /** Load straight away: for a clip that is above the fold. */
  eager?: boolean;
}

const { id, caption, eager = false } = Astro.props;
const clip = DEMO_CLIPS[id];
if (!clip) throw new Error(`DemoVideo: no clip "${id}" in src/data/demoClips.js`);
const urls = clipUrls(id);
---

<figure class="demo-video not-content my-8">
  <video
    class="block h-auto w-full rounded-card border border-white/10 bg-black"
    data-demo-video
    data-eager={eager ? '' : undefined}
    aria-label={clip.name}
    muted
    autoplay
    loop
    playsinline
    preload="none"
    poster={urls.poster}
    width={clip.width}
    height={clip.height}
  >
    <source data-src={urls.webm} type="video/webm" />
    <source data-src={urls.mp4} type="video/mp4" />
  </video>
  <noscript><p class="mt-2 text-center text-sm"><a href={urls.mp4} class="text-brand-400 underline hover:text-brand-hover">Watch the video ({clip.name})</a></p></noscript>
  <figcaption class="mt-3 text-center text-sm text-ink-400">{caption ?? clip.caption}</figcaption>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(videoObjectSchema({ id, ...clip }, SITE.url))} />
</figure>

<script>
  import { setUpDemoVideos } from '../scripts/demo-video.js';
  setUpDemoVideos(document, window);
</script>
