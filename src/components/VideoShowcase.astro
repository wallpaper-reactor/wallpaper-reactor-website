---
import SectionTitle from './SectionTitle.astro';

/** `mobileHidden` items drop out below 768px, matching .video-item-mobile-hidden. */
const VIDEOS = [
  { src: '/assets/videos/halo.mp4', mobileHidden: false },
  { src: '/assets/videos/star-citizen.mp4', mobileHidden: false },
  { src: '/assets/videos/synthwave.mp4', mobileHidden: false },
  { src: '/assets/videos/ps3.mp4', mobileHidden: false },
  { src: '/assets/videos/jake.mp4', mobileHidden: true },
  { src: '/assets/videos/f1.mp4', mobileHidden: true },
];
---

<section class="relative mx-auto max-w-[1400px] px-8 pb-8 pt-4 max-md:px-6 max-md:pb-6">
  <div class="relative">
    <SectionTitle>See it in action</SectionTitle>

    <div class="video-grid">
      {
        VIDEOS.map((v) => (
          <div class:list={['video-item', v.mobileHidden && 'video-item-mobile-hidden']}>
            <video autoplay loop muted playsinline preload="metadata">
              <source src={v.src} type="video/mp4" />
            </video>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .video-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .video-item-mobile-hidden {
      display: none;
    }
  }

  .video-item {
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    background: #000;
    cursor: pointer;
    border: 1px solid rgba(90, 163, 255, 0.2);
    box-shadow:
      0 20px 40px -12px rgba(0, 0, 0, 0.5),
      0 0 60px rgba(90, 163, 255, 0.15);
    transition: all 0.4s ease;
  }

  .video-item::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(90, 163, 255, 0.1) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    z-index: 1;
  }

  .video-item:hover {
    transform: translateY(-8px) scale(1.02);
    border-color: rgba(90, 163, 255, 0.4);
    box-shadow:
      0 30px 60px -12px rgba(0, 0, 0, 0.7),
      0 0 100px rgba(90, 163, 255, 0.3);
  }

  .video-item:hover::before {
    opacity: 1;
  }

  .video-item video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    pointer-events: none;
  }
</style>
