---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { STORES } from '../data/site';
import { DOWNLOADS, LATEST, formatDate } from '../data/releases';
import { CURRENT_PATTERNS } from '../data/releaseAssets';

/**
 * Rows of the install table. `href` null means the build isn't in this release; an `optional` row
 * with no build is left out rather than shown as missing. Names are matched in `data/releaseAssets.ts`.
 */
interface Row {
  os: string | null;
  icon?: string;
  build: string;
  recommended: boolean;
  href?: string;
  label?: string;
  external?: boolean;
  optional?: boolean;
  id?: string;
}

const url = (a?: { browser_download_url: string }) => a?.browser_download_url;
const hasMac = Boolean(DOWNLOADS.macUniversal || DOWNLOADS.macArm || DOWNLOADS.macIntel);

const ALL_ROWS: Row[] = [
  { os: 'macOS', icon: '/assets/images/apple-logo-fill.svg', build: 'Universal<br />(Apple Silicon & Intel)', recommended: true, href: url(DOWNLOADS.macUniversal), optional: hasMac },
  { os: null, build: 'Apple Silicon', recommended: true, href: url(DOWNLOADS.macArm), optional: true },
  { os: null, build: 'Intel', recommended: true, href: url(DOWNLOADS.macIntel), optional: true },
  { os: null, build: 'Mac App Store<br />(Apple Silicon)', recommended: false, href: STORES.appStoreLite, label: 'Mac App Store', external: true },
  { os: 'Windows', icon: '/assets/images/windows-logo-fill.svg', build: 'Microsoft Store<br />(Intel/AMD)', recommended: true, href: STORES.microsoft, label: 'Microsoft Store', external: true },
  {
    os: null,
    build: DOWNLOADS.windowsX64 && !CURRENT_PATTERNS.windowsX64.test(DOWNLOADS.windowsX64.name) ? 'Direct Install<br />(Intel/AMD & ARM)' : 'Direct Install<br />(Intel/AMD)',
    recommended: false,
    href: url(DOWNLOADS.windowsX64),
  },
  { os: null, build: 'Direct Install<br />(ARM)', recommended: false, href: url(DOWNLOADS.windowsArm), optional: true },
  { os: 'Android', icon: '/assets/images/android-logo-fill.svg', build: 'Google Play', recommended: true, href: STORES.googlePlay, label: 'Google Play', external: true },
  { os: null, build: 'Universal APK', recommended: false, href: url(DOWNLOADS.androidApk) },
  { id: 'linux', os: 'Linux<br />(KDE Plasma 6 only)', icon: '/assets/images/linux-logo-fill.svg', build: '.deb<br />(Debian, Ubuntu)', recommended: true, href: url(DOWNLOADS.linuxDeb) },
  { os: null, build: 'Flatpak<br />(SteamOS, Fedora, others)', recommended: false, href: url(DOWNLOADS.linuxFlatpak) },
];

const ROWS = ALL_ROWS.filter((row) => row.href || !row.optional);
---

<BaseLayout
  title="Releases"
  description="Download the latest Wallpaper Reactor builds for macOS, Windows, Android, and Linux (KDE Plasma)."
>
  <div class="prose-wr max-w-none">
    <h1>Releases</h1>
  </div>

  <section class="mx-auto max-w-7xl py-12">
    <h2 class="mb-2 text-center text-3xl font-semibold text-ink-100">Download from App Stores</h2>
    <p class="mx-auto mb-12 max-w-3xl text-center text-ink-400">
      Get Wallpaper Reactor on your favorite platform. Fast, secure, and auto‑updating.
    </p>

    <div class="mb-12">
      <StoreButtons />
    </div>

    <div class="mx-auto max-w-3xl rounded-lg border-l-[3px] border-brand-500 bg-brand-500/5 px-6 py-4">
      <p class="m-0 text-[0.9rem] text-ink-400">
        <strong class="text-ink-100">Note:</strong> The Mac App Store version is "Wallpaper Reactor Lite"
        with limited features. See the <a href="/features/" class="text-brand-500">features
        documentation</a> for version differences, or download the full macOS version below.
      </p>
    </div>
  </section>

  <div class="mt-16 text-center">
    <h2 class="text-4xl font-bold tracking-tight text-ink-100">Other Install Files</h2>
  </div>

  <div class="my-8 text-center">
    <h3 class="text-xl font-semibold text-ink-100">{LATEST.name} ({LATEST.tag})</h3>
    <p class="text-ink-400"><strong class="text-ink-100">Published on</strong> {formatDate(LATEST.publishedAt)}</p>
  </div>

  <div class="prose-wr mx-auto max-w-4xl overflow-x-auto">
    <table>
      <thead>
        <tr>
          <th>Operating System</th>
          <th>Build</th>
          <th>Recommended</th>
          <th>Link</th>
        </tr>
      </thead>
      <tbody>
        {
          ROWS.map((row) => (
            <tr id={row.id}>
              <td>
                {row.os ? (
                  <strong class="inline-flex items-start gap-2">
                    {row.icon && <img src={row.icon} alt="" class="mt-0.5 h-5 w-5 shrink-0 invert" />}
                    <span set:html={row.os} />
                  </strong>
                ) : (
                  ''
                )}
              </td>
              <td set:html={row.build} />
              <td>{row.recommended ? '✅' : '❌'}</td>
              <td>
                {row.href ? (
                  <a href={row.href} {...(row.external ? { target: '_blank', rel: 'noopener' } : {})}>
                    {row.label ?? 'Download'}
                  </a>
                ) : (
                  <span class="text-ink-500">Not in this release</span>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="mx-auto mt-6 max-w-3xl rounded-lg border-l-[3px] border-brand-500 bg-brand-500/5 px-6 py-4">
    <p class="m-0 text-[0.9rem] text-ink-400">
      <strong class="text-ink-100">Linux:</strong> KDE Plasma 6 on x86_64 only. See
      <a href="/docs/getting-started/#linux" class="text-brand-500">Getting Started</a> for install steps.
    </p>
  </div>

  <p class="mt-6 text-center text-sm text-ink-400">
    All builds and checksums are on the
    <a href={LATEST.htmlUrl} target="_blank" rel="noopener" class="text-brand-400 hover:text-brand-hover"
      >GitHub release page</a
    >.
  </p>
</BaseLayout>
