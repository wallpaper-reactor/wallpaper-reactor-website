---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title="Blog"
  description="Guides, comparisons, and technical write-ups on live wallpapers across Android, Windows, and macOS."
>
  <div class="prose-wr mx-auto max-w-4xl">
    <h1>Blog</h1>
    <p>
      Guides, comparisons, and technical write-ups about live wallpapers — how they work, how to make
      them, and how to get them running on every device you own.
    </p>
  </div>

  <ul class="mx-auto mt-8 max-w-4xl space-y-6">
    {
      posts.map((post) => (
        <li class="rounded-card border border-white/10 bg-surface-900 p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-400/30">
          <a href={`/blog/${post.id}/`} class="text-lg font-semibold text-brand-400 hover:text-brand-hover">
            {post.data.title}
          </a>
          <p class="mt-2 mb-0 text-sm leading-relaxed text-ink-400">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
