---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaButton from '../components/CtaButton.astro';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist or has been moved.">
  <div class="flex flex-col items-center justify-center px-4 py-24 text-center">
    <h1
      class="m-0 bg-linear-135 from-white to-brand-400 bg-clip-text text-[8rem] font-extrabold leading-none tracking-tight text-transparent max-md:text-[6rem]"
    >
      404
    </h1>
    <h2 class="my-6 text-3xl font-semibold text-ink-100 max-md:text-2xl">Page Not Found</h2>
    <p class="mb-10 text-lg text-ink-400">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <CtaButton href="/">Go Back Home</CtaButton>
  </div>
</BaseLayout>
